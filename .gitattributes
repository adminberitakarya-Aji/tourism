# Normalisasi line ending — teks selalu LF di repo, checkout sesuai OS
* text=auto eol=lf

# YAML/JSON/MD/TS eksplisit LF
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf

# Windows-only files
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary
